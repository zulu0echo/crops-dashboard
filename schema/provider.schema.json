{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provider.schema.json",
  "title": "Provider",
  "description": "One payment rail. Cross-field evidence rules (tier caps, criterion coverage, incumbent shape) live in scripts/validate.mjs because JSON Schema expresses them badly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "type",
    "website",
    "repos",
    "contracts",
    "scores",
    "notes",
    "components"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "type": {
      "enum": [
        "checkout",
        "card",
        "remittance",
        "transfer",
        "incumbent"
      ],
      "description": "transfer: person-to-person value transfer protocols, including privacy protocols."
    },
    "website": {
      "$ref": "#/$defs/url"
    },
    "primary_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "basis"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "chain_id": {
          "type": "integer",
          "minimum": 1
        },
        "basis": {
          "type": "string",
          "minLength": 20,
          "maxLength": 600,
          "description": "Why this chain or deployment is the unit of assessment, with the evidence for it (methodology 2.1), and what was excluded."
        },
        "caip2": {
          "$ref": "#/$defs/caip2"
        }
      },
      "oneOf": [
        {
          "required": [
            "chain_id"
          ]
        },
        {
          "required": [
            "caip2"
          ]
        }
      ]
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "role",
          "license"
        ],
        "properties": {
          "url": {
            "$ref": "#/$defs/url"
          },
          "role": {
            "enum": [
              "sdk",
              "contracts",
              "backend",
              "indexer",
              "frontend",
              "deploy",
              "docs"
            ]
          },
          "license": {
            "type": "string",
            "pattern": "^([A-Za-z0-9.+-]+|none|source-available)$"
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "role",
          "verified"
        ],
        "properties": {
          "address": {
            "$ref": "#/$defs/address"
          },
          "chain_id": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "type": "string",
            "maxLength": 60
          },
          "verified": {
            "enum": [
              "sourcify",
              "explorer",
              "verified-build",
              "none"
            ],
            "description": "verified-build: a reproducible build registry for non-EVM chains (e.g. the OtterSec Solana verify registry)."
          },
          "caip2": {
            "$ref": "#/$defs/caip2"
          }
        },
        "oneOf": [
          {
            "required": [
              "chain_id"
            ]
          },
          {
            "required": [
              "caip2"
            ]
          }
        ]
      }
    },
    "scores": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][0-9]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/cell"
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "description": "Every component in the payment path, public or not. Scores for F1, O2, F3, C3, P4, S4 and absence criteria are checked against this list.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "public",
          "license",
          "operator",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "role": {
            "enum": [
              "contracts",
              "sdk",
              "frontend",
              "backend",
              "api",
              "relayer",
              "signer",
              "indexer",
              "paymaster",
              "bundler",
              "oracle",
              "kyc",
              "card-issuer",
              "card-network",
              "ledger",
              "wallet",
              "other"
            ]
          },
          "public": {
            "type": "boolean"
          },
          "license": {
            "type": "string",
            "pattern": "^([A-Za-z0-9.+-]+|none|source-available|proprietary)$"
          },
          "operator": {
            "type": "string",
            "maxLength": 80
          },
          "required": {
            "type": "boolean",
            "description": "true if a payment cannot complete without it"
          },
          "repo": {
            "$ref": "#/$defs/url"
          }
        }
      }
    },
    "context": {
      "type": "string",
      "maxLength": 2000,
      "description": "Protections outside CROPS (regulation, safeguarding, legal recourse). Shown as context, never scored."
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "evidence",
        "checked_at"
      ],
      "description": "Where the product is offered, per the provider's own documents or code. Displayed on the Countries pages; never scored.",
      "properties": {
        "model": {
          "enum": [
            "global",
            "allowlist",
            "blocklist"
          ],
          "description": "global: offered everywhere (protocols with no restriction in contracts or official clients). allowlist: offered only in `countries`. blocklist: offered everywhere except `countries`."
        },
        "countries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([A-Z]{2}|EU|EEA)$"
          },
          "uniqueItems": true,
          "description": "ISO 3166-1 alpha-2 codes, or the region names in data/regions.yaml."
        },
        "note": {
          "type": "string",
          "maxLength": 1200,
          "description": "Sub-national limits (e.g. US states), product variants, or the difference between protocol access and the official app."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "checked_at": {
          "$ref": "#/$defs/date"
        }
      },
      "if": {
        "properties": {
          "model": {
            "enum": [
              "allowlist",
              "blocklist"
            ]
          }
        }
      },
      "then": {
        "required": [
          "countries"
        ]
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "evidence",
        "checked_at"
      ],
      "description": "What the user's balance is held in and debited from when the card is used. Displayed as context next to the ratings; never scored.",
      "properties": {
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "class"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "class": {
                "enum": [
                  "stablecoin",
                  "native",
                  "platform",
                  "other"
                ],
                "description": "stablecoin: tracks a fiat currency. native: the gas token of a chain (ETH, SOL, AVAX). platform: issued by the card provider or its own ecosystem. other: liquid-staking, wrapped or yield tokens; say which in note."
              },
              "backing": {
                "enum": [
                  "fiat",
                  "crypto",
                  "synthetic"
                ],
                "description": "Stablecoins only. fiat: redeemable reserves held by an issuer (USDC, USDT, EURe). crypto: over-collateralised onchain (DAI). synthetic: hedged or algorithmic (USDe)."
              },
              "issuer": {
                "type": "string",
                "maxLength": 120
              },
              "default": {
                "type": "boolean",
                "description": "The token the card spends from by default, when several are accepted."
              },
              "chain_id": {
                "type": "integer"
              },
              "caip2": {
                "type": "string",
                "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
              },
              "address": {
                "type": "string",
                "minLength": 20,
                "maxLength": 64
              }
            },
            "if": {
              "properties": {
                "class": {
                  "const": "stablecoin"
                }
              }
            },
            "then": {
              "required": [
                "backing"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "backing"
                ]
              }
            }
          }
        },
        "conversion": {
          "enum": [
            "none",
            "at_spend",
            "at_top_up",
            "unknown"
          ],
          "description": "none: the card network is settled from the token directly. at_spend: the token is sold for fiat when a payment is authorised. at_top_up: the token is converted into a fiat balance when the user tops up, so spend is from fiat."
        },
        "note": {
          "type": "string",
          "maxLength": 1200
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "checked_at": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "audits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "searched",
        "checked_at",
        "reports"
      ],
      "description": "Log of published security audits and similar reviews of the provider's code. Shown under Security as context; the S6 rating scores them.",
      "properties": {
        "searched": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1200,
          "description": "Where the log was compiled from: the provider's audit page, repositories' audit folders, auditors' public report portfolios. Completeness is only as good as these sources."
        },
        "checked_at": {
          "$ref": "#/$defs/date"
        },
        "reports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "auditor",
              "date",
              "type",
              "scope",
              "url",
              "covers_deployed"
            ],
            "properties": {
              "auditor": {
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$",
                "description": "Report date, YYYY-MM or YYYY-MM-DD."
              },
              "type": {
                "enum": [
                  "audit",
                  "formal_verification",
                  "contest",
                  "review",
                  "pentest"
                ]
              },
              "scope": {
                "type": "string",
                "minLength": 3,
                "maxLength": 400
              },
              "url": {
                "type": "string",
                "pattern": "^https://",
                "maxLength": 600,
                "description": "The report itself, on the provider's or auditor's own site or repository."
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{7,40}$"
              },
              "repo": {
                "type": "string",
                "pattern": "^https://"
              },
              "covers_deployed": {
                "enum": [
                  "yes",
                  "partly",
                  "no",
                  "unknown"
                ],
                "description": "Whether the audited code is what is deployed on the assessed chain today."
              },
              "findings": {
                "type": "string",
                "maxLength": 300
              },
              "note": {
                "type": "string",
                "maxLength": 600
              },
              "blocked_to_bots": {
                "type": "boolean",
                "description": "The report URL is genuine but refuses scripted requests (for example HTTP 403 from a bot filter), so the automatic link check skips it. Requires a note saying where the link is published."
              }
            },
            "if": {
              "properties": {
                "blocked_to_bots": {
                  "const": true
                }
              },
              "required": [
                "blocked_to_bots"
              ]
            },
            "then": {
              "required": [
                "note"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "url": {
      "type": "string",
      "pattern": "^https://[^\\s<>\"']+$",
      "maxLength": 500
    },
    "address": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        {
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        }
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": {
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "unknown": {
          "const": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "finding": {
          "type": "string",
          "maxLength": 2000
        },
        "provider_response": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        },
        "assessed_by": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "reviewed"
              ]
            },
            "by": {
              "type": "string",
              "maxLength": 120
            },
            "date": {
              "$ref": "#/$defs/date"
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "reviewed"
              }
            }
          },
          "then": {
            "required": [
              "by",
              "date"
            ]
          }
        },
        "disputed": {
          "type": "boolean",
          "description": "Set when admissible-but-contested or third-party evidence disputes the score. Shown on the site; does not change the score."
        }
      },
      "oneOf": [
        {
          "required": [
            "score",
            "evidence",
            "finding"
          ],
          "not": {
            "required": [
              "unknown"
            ]
          }
        },
        {
          "required": [
            "unknown"
          ],
          "not": {
            "required": [
              "score"
            ]
          }
        }
      ],
      "required": [
        "assessed_by",
        "review"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "kind",
        "url",
        "detail",
        "checked_at"
      ],
      "properties": {
        "tier": {
          "enum": [
            "verified",
            "documented",
            "claimed"
          ]
        },
        "kind": {
          "enum": [
            "onchain",
            "repo",
            "document",
            "trace"
          ]
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "checked_at": {
          "$ref": "#/$defs/date"
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "chain_id": {
          "type": "integer",
          "minimum": 1
        },
        "block_number": {
          "type": "integer",
          "minimum": 0
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "maxLength": 300
        },
        "check": {
          "description": "Machine-readable onchain fact for the nightly re-check. Compares the raw 32-byte word returned now to expect.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expect"
          ],
          "properties": {
            "call": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{8}([0-9a-f]{64})*$"
            },
            "slot": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{1,64}$"
            },
            "expect": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            }
          },
          "oneOf": [
            {
              "required": [
                "call"
              ]
            },
            {
              "required": [
                "slot"
              ]
            }
          ]
        },
        "drift": {
          "type": "boolean"
        },
        "confirmed_at": {
          "$ref": "#/$defs/date",
          "description": "Set by the weekly refresh when a re-read found the source unchanged. Counts as fresh for staleness; does not re-judge the rating."
        },
        "by": {
          "enum": [
            "provider",
            "third_party"
          ],
          "description": "Required for tier claimed. Only a provider admission can lower a score."
        },
        "recheck": {
          "type": "string",
          "minLength": 10,
          "maxLength": 800,
          "description": "Command or click path that reproduces the fact. Required on at least one item of any cell scored 2 or 3."
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "integrity"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "integrity": {
              "type": "string",
              "pattern": "^sha(256|384|512)-[A-Za-z0-9+/=]+$"
            }
          }
        },
        "quote": {
          "type": "string",
          "minLength": 8,
          "maxLength": 300,
          "description": "Exact phrase from the document; CI checks the page (or archive) contains it."
        },
        "archive": {
          "type": "string",
          "pattern": "^data/archive/[a-z0-9._-]+$",
          "description": "Committed copy of the document, for pages that block automated access or change."
        },
        "eoa": {
          "const": true,
          "description": "The address is an externally owned account; skips the code-exists check."
        },
        "caip2": {
          "$ref": "#/$defs/caip2"
        },
        "historical": {
          "const": true,
          "description": "Cites a past state on purpose (e.g. a licence before a relicense). Excluded from the nightly drift check."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tier": {
                "const": "claimed"
              }
            }
          },
          "then": {
            "required": [
              "by"
            ]
          }
        },
        {
          "if": {
            "required": [
              "tier",
              "kind"
            ],
            "properties": {
              "tier": {
                "const": "documented"
              },
              "kind": {
                "const": "document"
              }
            }
          },
          "then": {
            "required": [
              "quote"
            ]
          }
        }
      ]
    },
    "caip2": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$",
      "description": "CAIP-2 chain id for non-EVM chains, e.g. solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"
    }
  }
}

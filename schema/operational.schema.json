{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operational.schema.json",
  "title": "Operational and procurement record",
  "description": "One file per provider in data/operational/<slug>.yaml. Facts, never ratings; never enters the CROPS rollup. Every fact has one of five states: evidenced, attested, unknown, absent, not_applicable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "fees": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "paid_by",
                  "amount"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "provider",
                      "network",
                      "fx",
                      "card",
                      "cashout",
                      "limit"
                    ]
                  },
                  "paid_by": {
                    "enum": [
                      "payer",
                      "payee",
                      "both",
                      "none"
                    ]
                  },
                  "amount": {
                    "type": "string",
                    "maxLength": 120,
                    "description": "As stated: '0.1%', '1 USDC', 'gas at 0.05 gwei sample', 'min 10 EUR'."
                  },
                  "basis": {
                    "type": "string",
                    "maxLength": 300,
                    "description": "Where it is set and whether it can change (contract parameter, pricing page, partner)."
                  },
                  "evidence_index": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Index into this fact's evidence list."
                  }
                }
              }
            }
          }
        }
      ]
    },
    "custody_model": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "enum": [
                "self_custody",
                "provider_custodial",
                "hybrid"
              ]
            }
          }
        }
      ]
    },
    "licences": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "entity",
                  "country",
                  "regulator",
                  "type"
                ],
                "properties": {
                  "entity": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "holder": {
                    "enum": [
                      "provider",
                      "partner"
                    ],
                    "default": "provider"
                  },
                  "country": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  },
                  "regulator": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "type": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "number": {
                    "type": "string",
                    "maxLength": 60
                  },
                  "activities": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "register_url": {
                    "type": "string",
                    "pattern": "^https://",
                    "maxLength": 500
                  },
                  "evidence_index": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "cashout": {
      "allOf": [
        {
          "$ref": "#/$defs/fact"
        },
        {
          "properties": {
            "value": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "countries",
                  "method"
                ],
                "properties": {
                  "countries": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "^([A-Z]{2}|EU|EEA|ALL)$"
                    },
                    "description": "ISO codes, EU/EEA, or ALL for every country in the availability list."
                  },
                  "method": {
                    "enum": [
                      "card_spend",
                      "card_withdrawal",
                      "bank_transfer",
                      "atm",
                      "cash_agent",
                      "mobile_money",
                      "p2p",
                      "exchange",
                      "none"
                    ]
                  },
                  "partner": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "fee": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "limits": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "evidence_index": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "maturity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first_deployment": {
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            },
            {
              "properties": {
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "date"
                  ],
                  "properties": {
                    "date": {
                      "$ref": "#/$defs/date"
                    },
                    "block": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "what": {
                      "type": "string",
                      "maxLength": 200
                    }
                  }
                }
              }
            }
          ]
        },
        "entity": {
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            },
            {
              "properties": {
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "legal_name",
                    "jurisdiction"
                  ],
                  "properties": {
                    "legal_name": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "jurisdiction": {
                      "type": "string",
                      "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"
                    },
                    "register_url": {
                      "type": "string",
                      "pattern": "^https://",
                      "maxLength": 500
                    },
                    "registration_number": {
                      "type": "string",
                      "maxLength": 60
                    }
                  }
                }
              }
            }
          ]
        },
        "incidents": {
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            },
            {
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "date",
                      "summary",
                      "funds_lost",
                      "url"
                    ],
                    "properties": {
                      "date": {
                        "$ref": "#/$defs/date"
                      },
                      "summary": {
                        "type": "string",
                        "maxLength": 400
                      },
                      "funds_lost": {
                        "enum": [
                          "yes",
                          "no",
                          "unknown"
                        ]
                      },
                      "url": {
                        "type": "string",
                        "pattern": "^https://",
                        "maxLength": 500
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "changes": {
          "allOf": [
            {
              "$ref": "#/$defs/fact"
            },
            {
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "date",
                      "summary",
                      "url"
                    ],
                    "properties": {
                      "date": {
                        "$ref": "#/$defs/date"
                      },
                      "summary": {
                        "type": "string",
                        "maxLength": 400
                      },
                      "url": {
                        "type": "string",
                        "pattern": "^https://",
                        "maxLength": 500
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "assessed_by",
        "review"
      ],
      "properties": {
        "status": {
          "enum": [
            "evidenced",
            "not_observable",
            "not_verifiable",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 600
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chain_id",
            "addresses",
            "topic0",
            "window_days"
          ],
          "description": "The reproducible query. amount_word and token_word index 32-byte words of the log data (0-based); token may instead be fixed.",
          "properties": {
            "chain_id": {
              "type": "integer",
              "minimum": 1
            },
            "addresses": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              }
            },
            "topic0": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "event": {
              "type": "string",
              "maxLength": 200
            },
            "amount_word": {
              "type": "integer",
              "minimum": 0
            },
            "token_word": {
              "type": "integer",
              "minimum": 0
            },
            "token": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 36
            },
            "symbol": {
              "type": "string",
              "maxLength": 12
            },
            "window_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 400
            },
            "exclusions": {
              "type": "string",
              "maxLength": 600
            }
          }
        },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from_block",
            "to_block",
            "computed_at",
            "events",
            "results"
          ],
          "properties": {
            "from_block": {
              "type": "integer"
            },
            "to_block": {
              "type": "integer"
            },
            "computed_at": {
              "$ref": "#/$defs/date"
            },
            "events": {
              "type": "integer",
              "minimum": 0
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "token",
                  "count",
                  "sum"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "symbol": {
                    "type": "string"
                  },
                  "decimals": {
                    "type": "integer"
                  },
                  "count": {
                    "type": "integer"
                  },
                  "sum": {
                    "type": "string",
                    "description": "Raw integer sum as a decimal string."
                  },
                  "sum_units": {
                    "type": "string",
                    "description": "Sum divided by 10^decimals, as a string."
                  }
                }
              }
            },
            "rpc": {
              "type": "string",
              "maxLength": 200
            },
            "calls": {
              "type": "integer"
            }
          }
        },
        "note": {
          "type": "string",
          "maxLength": 1200
        },
        "assessed_by": {
          "type": "string",
          "maxLength": 120
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "evidenced"
              }
            }
          },
          "then": {
            "required": [
              "spec",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_observable",
                  "not_verifiable"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "facts": {
      "type": "object",
      "description": "Group B controls, keyed by control id from data/operational-criteria.yaml.",
      "propertyNames": {
        "pattern": "^B[0-9]{1,2}\\.[0-9]{1,2}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/fact"
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "reviewed"
          ]
        },
        "by": {
          "type": "string",
          "maxLength": 120
        },
        "date": {
          "$ref": "#/$defs/date"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "reviewed"
          }
        }
      },
      "then": {
        "required": [
          "by",
          "date"
        ]
      }
    },
    "api_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "kind",
        "url",
        "detail",
        "checked_at"
      ],
      "description": "Machine-readable public state read from an API (GitHub). Verified because anyone can re-read it.",
      "properties": {
        "tier": {
          "const": "verified"
        },
        "kind": {
          "const": "api"
        },
        "url": {
          "type": "string",
          "pattern": "^https://api\\.github\\.com/",
          "maxLength": 500
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "checked_at": {
          "$ref": "#/$defs/date"
        },
        "recheck": {
          "type": "string",
          "maxLength": 800
        }
      }
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "provider.schema.json#/$defs/evidence"
        },
        {
          "$ref": "#/$defs/api_evidence"
        }
      ]
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion",
        "index"
      ],
      "properties": {
        "criterion": {
          "type": "string",
          "pattern": "^[A-Z][0-9]+$"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Points at an evidence item in the provider file: scores.<criterion>.evidence[index]."
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "assessed_by",
        "review"
      ],
      "properties": {
        "status": {
          "enum": [
            "evidenced",
            "attested",
            "unknown",
            "absent",
            "not_applicable"
          ]
        },
        "value": {},
        "note": {
          "type": "string",
          "maxLength": 1200
        },
        "reason": {
          "type": "string",
          "maxLength": 600,
          "description": "Required for not_applicable: why the control does not apply."
        },
        "burden": {
          "enum": [
            "institution",
            "none"
          ],
          "description": "For not_applicable: who holds the control instead (the deploying institution, or nobody because no such service exists)."
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "checked_at": {
          "$ref": "#/$defs/date"
        },
        "assessed_by": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "required": [
              "reason",
              "burden"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "evidenced",
                  "attested",
                  "absent"
                ]
              }
            }
          },
          "then": {
            "required": [
              "checked_at"
            ]
          }
        }
      ]
    }
  }
}
